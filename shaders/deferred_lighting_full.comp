#version 460 core

layout(local_size_x = 256) in;

layout(binding = 0) uniform sampler2D uAlbedo;
layout(binding = 1) uniform sampler2D uNormal;
layout(binding = 2) uniform sampler2D uPosition;
layout(rgba16f, binding = 0) uniform writeonly image2D uOutput;

uniform vec3 uEye;
uniform int uLightCount;

vec3 lightPosition(int i) {
    float fi = float(i);
    float a = fi * 2.39996323;
    float ring = 2.8 + float(i % 7) * 0.72;
    return vec3(cos(a) * ring, 1.2 + float(i % 5) * 0.64, sin(a) * ring - 1.2);
}

vec3 lightColor(int i) {
    float fi = float(i);
    return 0.65 + 0.35 * vec3(
        0.5 + 0.5 * sin(fi * 1.71 + 0.2),
        0.5 + 0.5 * sin(fi * 1.13 + 2.1),
        0.5 + 0.5 * sin(fi * 0.91 + 4.0)
    );
}

vec3 shade(vec3 albedo, vec3 normal, vec3 worldPosition, float roughness) {
    vec3 N = normalize(normal);
    vec3 V = normalize(uEye - worldPosition);
    vec3 result = albedo * 0.028;

    for (int i = 0; i < uLightCount; ++i) {
        vec3 toLight = lightPosition(i) - worldPosition;
        float distanceSquared = max(dot(toLight, toLight), 0.05);
        vec3 L = toLight * inversesqrt(distanceSquared);
        float ndotl = max(dot(N, L), 0.0);
        vec3 H = normalize(L + V);
        float exponent = mix(96.0, 8.0, roughness);
        float specular = pow(max(dot(N, H), 0.0), exponent) * mix(0.55, 0.08, roughness);
        float attenuation = (4.5 / sqrt(float(max(uLightCount, 1)))) / (1.0 + 0.28 * distanceSquared);
        vec3 radiance = lightColor(i) * attenuation;
        result += albedo * radiance * ndotl + radiance * specular;
    }
    return result;
}

void main() {
    ivec2 size = textureSize(uPosition, 0);
    uint pixelCount = uint(size.x * size.y);
    uint linearGroup =
        (gl_WorkGroupID.z * gl_NumWorkGroups.y + gl_WorkGroupID.y) * gl_NumWorkGroups.x
        + gl_WorkGroupID.x;
    uint invocation = linearGroup * gl_WorkGroupSize.x + gl_LocalInvocationIndex;
    if (invocation >= pixelCount) return;

    ivec2 pixel = ivec2(int(invocation % uint(size.x)), int(invocation / uint(size.x)));
    vec4 positionData = texelFetch(uPosition, pixel, 0);
    if (positionData.a < 0.5) return;

    vec4 albedoData = texelFetch(uAlbedo, pixel, 0);
    vec3 normal = texelFetch(uNormal, pixel, 0).rgb * 2.0 - 1.0;
    vec3 color = shade(albedoData.rgb, normal, positionData.xyz, albedoData.a);
    imageStore(uOutput, pixel, vec4(color, 1.0));
}
